    <category>Building</category>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <replaceTags>
      <li>Wall</li>
    </replaceTags>
    <graphicData>
      <texPath>Things/OrcWall/aPurpleApple_OrcWall</texPath>
